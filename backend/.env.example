# ADAM AI Code Generator - Environment Configuration
# Copy this file to .env and fill in your API keys

# Application Settings
DEBUG=False
APP_NAME="ADAM AI Code Generator"
APP_VERSION="1.0.0"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM API Keys
# Groq API (RECOMMENDED - Free Tier)
# Sign up: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400 requests/day
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Paid)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (Paid)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (Free tier with rate limits)
GOOGLE_API_KEY=your_google_api_key_here

# Amazon Bedrock (optional; uses the AWS credential chain, no key stored here)
BEDROCK_ENABLED=false
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
# BEDROCK_PROMPT_CACHING=true

# Agentic ADaM pipeline (app/modules/adam_agent)
# Cheapest model first; the agent escalates one tier per failed attempt
# ADAM_AGENT_ROUTES=bedrock:anthropic.claude-haiku-5-5,bedrock:anthropic.claude-sonnet-5-5
# ADAM_AGENT_ESCALATE_AFTER=1
# ADAM_AGENT_EXECUTOR=docker           # strict API default; local only for explicit non-strict development
# ADAM_AGENT_DOCKER_IMAGE=rocker/tidyverse:4.4.2
# RSCRIPT_PATH=C:/Program Files/R/R-4.4.2/bin/Rscript.exe
# ADAM_AGENT_AUDIT_PATH=storage/audit/adam_agent_audit.jsonl
# ADAM_AGENT_DATA_ROOTS=                # folders the API/MCP may read (os.pathsep-separated)
# ADAM_AGENT_REQUIRE_INDEPENDENT_REVIEW=true
# ADAM_AGENT_USD_INR=94.95
# ADAM_AGENT_PRICING_FILE=              # override app/modules/adam_agent/pricing.yaml

# Optional tracing (pip install langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Default LLM Configuration
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=4000

# File Paths (relative to backend/)
CONTENT_DIR=../Content
CONTEXT_DIR=../Context
RULES_DIR=../Context/ADAMRules

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/adam_ai.log

# Security
SECRET_KEY=replace_with_secure_random_value
